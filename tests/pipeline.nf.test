                prefix                     = "test"

                metadata_format            = "illumina"

                run_mageck_mle             = true
                run_mageck_test            = true

                count_program              = "mageck"
                normalization_method       = "median"
                design_matrix              = "${baseDir}/${testDataDir}/design_matrix/design_matrix-day0_baseline-by_condition_one_replicate.txt"
                gene_test_threshold        = 0.3
                gene_lfc_method            = "median"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path("${outputDir}/test.metadata.yaml"),
                    path("${outputDir}/guide_counts/test.count_normalized.txt"),
                    path("${outputDir}/guide_counts/test.count_report.Rmd"),
                    path("${outputDir}/guide_counts/test.countsummary.txt"),
                    path("${outputDir}/guide_counts/test.count.txt"),
                    path("${outputDir}/guide_counts/test.max_1000X.count.txt"),
                    path("${outputDir}/guide_counts/test.max_2000X.count.txt"),
                    path("${outputDir}/guide_counts/test.max_3000X.count.txt"),
                    path("${outputDir}/guide_counts/test.max_1000X.count.yml"),
                    path("${outputDir}/guide_counts/test.max_2000X.count.yml"),
                    path("${outputDir}/guide_counts/test.max_3000X.count.yml"),
                    path("${outputDir}/guide_counts/test.max_1000X.count_normalized.txt"),
                    path("${outputDir}/guide_counts/test.max_2000X.count_normalized.txt"),
                    path("${outputDir}/guide_counts/test.max_3000X.count_normalized.txt"),
                    path("${outputDir}/guide_qc/test.max_1000X.guide_data_long.tsv"),
                    path("${outputDir}/guide_qc/test.max_2000X.guide_data_long.tsv"),
                    path("${outputDir}/guide_qc/test.max_3000X.guide_data_long.tsv"),

                    // Include the paths for the MAGeCK test output files to ensure that
                    // all of the correct pairwise combinations were run
                    *OutputFiles.mageckTest(
                        "test",
                        [samples_vs_D0: ['D-10_untreated.vs.D0_untreated', 'D14_drug.vs.D0_untreated', 'D14_untreated.vs.D0_untreated']],
                        [1000, 2000, 3000],
                        ['sgrna_summary.txt', 'gene_summary.txt']
                    ).collect{ path("${outputDir}/${it}") },
                ).match() },

                { assert path("${outputDir}/guide_counts/mageck_count.log").exists() },
                { assert path("${outputDir}/guide_qc/test.mageck_count_report.nb.html").exists() },

                // Assert that correlation files are missing
                { assert ! path("${outputDir}/guide_qc/test.max_1000X.replicates_cor.tsv").exists() },
                { assert ! path("${outputDir}/guide_qc/test.max_2000X.replicates_cor.tsv").exists() },
                { assert ! path("${outputDir}/guide_qc/test.max_3000X.replicates_cor.tsv").exists() },
                { assert ! path("${outputDir}/guide_qc/test.replicates_cor.tsv").exists() },
                { assert ! path("${outputDir}/guide_qc/test.max_1000X.replicates_cor.pdf").exists() },
                { assert ! path("${outputDir}/guide_qc/test.max_2000X.replicates_cor.pdf").exists() },
                { assert ! path("${outputDir}/guide_qc/test.max_3000X.replicates_cor.pdf").exists() },

                // Assert MAGeCK MLE created the right output files
                { assert path("${outputDir}/analysis_1000X/mageck_mle/test.1000X.gene_summary.txt").exists() },
                { assert path("${outputDir}/analysis_1000X/mageck_mle/test.1000X.sgrna_summary.txt").exists() },
                { assert path("${outputDir}/analysis_2000X/mageck_mle/test.2000X.gene_summary.txt").exists() },
                { assert path("${outputDir}/analysis_2000X/mageck_mle/test.2000X.sgrna_summary.txt").exists() },
                { assert path("${outputDir}/analysis_3000X/mageck_mle/test.3000X.gene_summary.txt").exists() },
                { assert path("${outputDir}/analysis_3000X/mageck_mle/test.3000X.sgrna_summary.txt").exists() },
            )
        }
    }

