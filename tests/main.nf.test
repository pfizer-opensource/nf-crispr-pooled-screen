                path("${outputDir}/guide_counts/${params.prefix}.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_1000X.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_2000X.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_3000X.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_1000X.count.yml"),
                path("${outputDir}/guide_counts/${params.prefix}.max_2000X.count.yml"),
                path("${outputDir}/guide_counts/${params.prefix}.max_3000X.count.yml"),
                path("${outputDir}/guide_counts/${params.prefix}.max_1000X.count_normalized.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_2000X.count_normalized.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_3000X.count_normalized.txt"),
                path("${outputDir}/guide_qc/${params.prefix}.max_1000X.guide_data_long.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_2000X.guide_data_long.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_3000X.guide_data_long.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_1000X.replicates_cor.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_2000X.replicates_cor.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_3000X.replicates_cor.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.replicates_cor.tsv"),
                ).match()
            assert (path("${outputDir}/guide_counts/mageck_count.log").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.mageck_count_report.nb.html").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.max_1000X.replicates_cor.pdf").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.max_2000X.replicates_cor.pdf").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.max_3000X.replicates_cor.pdf").exists())

            assert (path("${outputDir}/analysis_1000X/mageck_mle/${params.prefix}.1000X.gene_summary.txt").exists())
            assert (path("${outputDir}/analysis_1000X/mageck_mle/${params.prefix}.1000X.sgrna_summary.txt").exists())
            assert (path("${outputDir}/analysis_2000X/mageck_mle/${params.prefix}.2000X.gene_summary.txt").exists())
            assert (path("${outputDir}/analysis_2000X/mageck_mle/${params.prefix}.2000X.sgrna_summary.txt").exists())
            assert (path("${outputDir}/analysis_3000X/mageck_mle/${params.prefix}.3000X.gene_summary.txt").exists())
            assert (path("${outputDir}/analysis_3000X/mageck_mle/${params.prefix}.3000X.sgrna_summary.txt").exists())

            assert  !(path("${outputDir}/mageck_test/").exists())

        }

    }

test("Main with MLE and Mageck Test") {
        tag "main" 
        tag "mle"
        tag "mageck_test"
        tag "mageck_test_with_ref"

        when {
            params {
                // define parameters here. Example:
                fastq_dir                  = "$baseDir/tests/test-datasets/testdata"
                metadata                   = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table_with_ref_column.csv"
                annotate_dictionary        = "$baseDir/tests/test-datasets/input_sample_table/annotate_dict.yml"
                design_matrix              = "$baseDir/tests/test-datasets/design_matrix/design_matrix-day0_baseline-by_condition.txt"
                library                    = "$baseDir/tests/test-datasets/library.txt"
                outdir                     = "$outputDir"
                count_program              = 'mageck'
                prefix                     = 'test'
                metadata_format            = 'csv'
                normalization_method       = 'total'
                
                // Mageck options
                run_mageck_mle             = true
                run_mageck_test            = true
                gene_test_threshold        = 0.25
                gene_lfc_method            = 'median'
                mageck_count_options       = '--trim-5 "22,23,24,25,26,28,29,30"'
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${outputDir}/${params.prefix}.metadata.yaml"),
                path("${outputDir}/guide_counts/${params.prefix}.count_normalized.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.count_report.Rmd"),
                path("${outputDir}/guide_counts/${params.prefix}.countsummary.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_1000X.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_2000X.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_3000X.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_1000X.count.yml"),
                path("${outputDir}/guide_counts/${params.prefix}.max_2000X.count.yml"),
                path("${outputDir}/guide_counts/${params.prefix}.max_3000X.count.yml"),
                path("${outputDir}/guide_counts/${params.prefix}.max_1000X.count_normalized.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_2000X.count_normalized.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_3000X.count_normalized.txt"),
                path("${outputDir}/guide_qc/${params.prefix}.max_1000X.guide_data_long.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_2000X.guide_data_long.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_3000X.guide_data_long.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_1000X.replicates_cor.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_2000X.replicates_cor.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_3000X.replicates_cor.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.replicates_cor.tsv"),

                // Assert mageck test ran all the correct combinations
                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_0_Treatment_untreated.vs.Day_-10_Treatment_untreated.1000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_0_Treatment_untreated.vs.Day_-10_Treatment_untreated.1000X.gene_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_0_Treatment_untreated.vs.Day_-10_Treatment_untreated.2000X.gene_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_0_Treatment_untreated.vs.Day_-10_Treatment_untreated.2000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_0_Treatment_untreated.vs.Day_-10_Treatment_untreated.3000X.gene_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_0_Treatment_untreated.vs.Day_-10_Treatment_untreated.3000X.sgrna_summary.txt"),

                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_14_Treatment_drug.vs.Day_-10_Treatment_untreated.1000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_14_Treatment_drug.vs.Day_-10_Treatment_untreated.1000X.gene_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_14_Treatment_drug.vs.Day_-10_Treatment_untreated.2000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_14_Treatment_drug.vs.Day_-10_Treatment_untreated.2000X.gene_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_14_Treatment_drug.vs.Day_-10_Treatment_untreated.3000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_14_Treatment_drug.vs.Day_-10_Treatment_untreated.3000X.gene_summary.txt"),
                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_14_Treatment_untreated.vs.Day_-10_Treatment_untreated.1000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_14_Treatment_untreated.vs.Day_-10_Treatment_untreated.1000X.gene_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_14_Treatment_untreated.vs.Day_-10_Treatment_untreated.2000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_14_Treatment_untreated.vs.Day_-10_Treatment_untreated.2000X.gene_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_14_Treatment_untreated.vs.Day_-10_Treatment_untreated.3000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_14_Treatment_untreated.vs.Day_-10_Treatment_untreated.3000X.gene_summary.txt"),

                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_28_Treatment_drug.vs.Day_-10_Treatment_untreated.1000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_28_Treatment_drug.vs.Day_-10_Treatment_untreated.1000X.gene_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_28_Treatment_drug.vs.Day_-10_Treatment_untreated.2000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_28_Treatment_drug.vs.Day_-10_Treatment_untreated.2000X.gene_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_28_Treatment_drug.vs.Day_-10_Treatment_untreated.3000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_28_Treatment_drug.vs.Day_-10_Treatment_untreated.3000X.gene_summary.txt"),
                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_28_Treatment_untreated.vs.Day_-10_Treatment_untreated.1000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_1000X/mageck_test/${params.prefix}.Day_28_Treatment_untreated.vs.Day_-10_Treatment_untreated.1000X.gene_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_28_Treatment_untreated.vs.Day_-10_Treatment_untreated.2000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_2000X/mageck_test/${params.prefix}.Day_28_Treatment_untreated.vs.Day_-10_Treatment_untreated.2000X.gene_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_28_Treatment_untreated.vs.Day_-10_Treatment_untreated.3000X.sgrna_summary.txt"),
                path("${outputDir}/analysis_3000X/mageck_test/${params.prefix}.Day_28_Treatment_untreated.vs.Day_-10_Treatment_untreated.3000X.gene_summary.txt")
                ).match()
            assert (path("${outputDir}/guide_counts/mageck_count.log").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.mageck_count_report.nb.html").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.max_1000X.replicates_cor.pdf").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.max_2000X.replicates_cor.pdf").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.max_3000X.replicates_cor.pdf").exists())

            assert path("${outputDir}/analysis_1000X/mageck_mle/${params.prefix}.1000X.gene_summary.txt").exists()
            assert path("${outputDir}/analysis_1000X/mageck_mle/${params.prefix}.1000X.sgrna_summary.txt").exists()
            assert path("${outputDir}/analysis_2000X/mageck_mle/${params.prefix}.2000X.gene_summary.txt").exists()
            assert path("${outputDir}/analysis_2000X/mageck_mle/${params.prefix}.2000X.sgrna_summary.txt").exists()
            assert path("${outputDir}/analysis_3000X/mageck_mle/${params.prefix}.3000X.gene_summary.txt").exists()
            assert path("${outputDir}/analysis_3000X/mageck_mle/${params.prefix}.3000X.sgrna_summary.txt").exists()

        }

    }

    test("Main Test with MLE - multiple design matrices and MLE options") {
        tag "main" 
        tag "mle"
        tag "mle_multi_matrix_and_options"

        when {
            params {
                // define parameters here. Example:
                fastq_dir                  = "$baseDir/tests/test-datasets/testdata"
                metadata                   = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table.csv"
                annotate_dictionary        = "$baseDir/tests/test-datasets/input_sample_table/annotate_dict.yml"
                design_matrix              = "$baseDir/tests/test-datasets/design_matrix/design_matrix-day0_baseline-by_condition.txt,time_vs_treatment:$baseDir/tests/test-datasets/design_matrix/design_matrix-day0_baseline-time_vs_treatment.txt,day_14:$baseDir/tests/test-datasets/design_matrix/design_matrix-day14_untreated_baseline-by_condition.txt"
                library                    = "$baseDir/tests/test-datasets/library.txt"
                outdir                     = "$outputDir"
                count_program              = 'mageck'
                prefix                     = 'test'
                metadata_format            = 'csv'
                normalization_method       = 'total'
                
                // Mageck options
                run_mageck_mle             = true
                mageck_count_options       = '--trim-5 "22,23,24,25,26,28,29,30"'
                mageck_mle_options         = '--update-efficiency'
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${outputDir}/${params.prefix}.metadata.yaml"),
                path("${outputDir}/guide_counts/${params.prefix}.count_normalized.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.count_report.Rmd"),
