    test("Detect MAGeCK MLE run without design matrix error") {
        tag "main"
        tag "mle"
        tag "mle_no_matrix_error"

        when {
            params {
                // define parameters here. Example:
                fastq_dir                  = "$baseDir/tests/test-datasets/testdata"
                metadata                   = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table.csv"
                annotate_dictionary        = "$baseDir/tests/test-datasets/input_sample_table/annotate_dict.yml"
                library                    = "$baseDir/tests/test-datasets/library.txt"
                outdir                     = "$outputDir"
                count_program              = 'mageck'
                prefix                     = 'test'
                metadata_format            = 'csv'
                normalization_method       = 'total'

                // Mageck options
                run_mageck_mle             = true
                mageck_count_options       = '--trim-5 "22,23,24,25,26,28,29,30"'
            }
        }

        then {
            assert workflow.exitStatus != 0
            assert workflow.stdout.join(" ").contains("Design matrix required to run MAGeCK MLE!")
        }

    }

    test("Detect MAGeCK test run without contrast metadata error") {
        tag "main"
        tag "mageck_test"
        tag "mageck_test_no_contrast_error"

        when {
            params {
                // define parameters here. Example:
                fastq_dir                  = "$baseDir/tests/test-datasets/testdata"
                metadata                   = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table.csv"
