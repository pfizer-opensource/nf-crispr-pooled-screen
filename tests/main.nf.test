nextflow_pipeline {

    name "Test Workflow main.nf"
    tag "pipeline"
    script "main.nf"

    // Note: test data is not included in public release

    test("Main Test") {
        tag "main"

        when {
            params {
                // define parameters here. Example:
                fastq_dir                  = "$baseDir/tests/test-datasets/testdata"
                metadata                   = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table.csv"
                annotate_dictionary        = "$baseDir/tests/test-datasets/input_sample_table/annotate_dict.yml"
                library                    = "$baseDir/tests/test-datasets/library.txt"
                outdir                     = "$outputDir"
                count_program              = 'mageck'
                prefix                     = 'test'
                metadata_format            = 'csv'
                normalization_method       = 'total'

                // Mageck options
                mageck_count_options       = '--trim-5 "22,23,24,25,26,28,29,30"'
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                path("${outputDir}/${params.prefix}.metadata.yaml"),
                path("${outputDir}/guide_counts/${params.prefix}.count_normalized.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.count_report.Rmd"),
                path("${outputDir}/guide_counts/${params.prefix}.countsummary.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_1000X.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_2000X.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_3000X.count.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_1000X.count.yml"),
                path("${outputDir}/guide_counts/${params.prefix}.max_2000X.count.yml"),
                path("${outputDir}/guide_counts/${params.prefix}.max_3000X.count.yml"),
                path("${outputDir}/guide_counts/${params.prefix}.max_1000X.count_normalized.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_2000X.count_normalized.txt"),
                path("${outputDir}/guide_counts/${params.prefix}.max_3000X.count_normalized.txt"),
                path("${outputDir}/guide_qc/${params.prefix}.max_1000X.guide_data_long.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_2000X.guide_data_long.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_3000X.guide_data_long.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_1000X.replicates_cor.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_2000X.replicates_cor.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.max_3000X.replicates_cor.tsv"),
                path("${outputDir}/guide_qc/${params.prefix}.replicates_cor.tsv"),
                ).match()
            assert (path("${outputDir}/guide_counts/mageck_count.log").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.mageck_count_report.nb.html").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.max_1000X.replicates_cor.pdf").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.max_2000X.replicates_cor.pdf").exists())
            assert (path("${outputDir}/guide_qc/${params.prefix}.max_3000X.replicates_cor.pdf").exists())
            
        }

    }
    
    test("Main Test with MLE") {
        tag "main" 
        tag "mle"
        tag "mle_one_matrix"

        when {
            params {
                // define parameters here. Example:
