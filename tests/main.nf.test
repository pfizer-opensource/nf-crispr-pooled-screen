                normalization_method       = 'total'

                // Mageck options
                run_mageck_test            = true
                mageck_count_options       = '--trim-5 "22,23,24,25,26,28,29,30"'
            }
        }

        then {
            assert workflow.exitStatus != 0
            assert workflow.stdout.join(" ").contains("At least one contrast required to run MAGeCK test!")
        }

    }

    test("Multi Character aliquot definition") {
        tag "multi_aliquot"
        when {
            params {
