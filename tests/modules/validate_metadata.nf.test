        then {
            assert process.success
            assert process.out.meta_yaml.get(0) ==~ ".*/${params.prefix}.metadata.yaml"
            assert snapshot(process.out.meta_yaml).match()
        }
    }

    test("Groups vs Conditions Error: One set of conditions in multiple groups") {
        tag "validate_metadata_group_error"
        tag "validate_metadata_group-vs-conditions_1_illumina"

        setup {
            run("PARSE_METADATA_ILLUMINA") {
                script "modules/local/parse_metadata_illumina.nf"

                process {
                    """
                    input[0] = params.metadata
                    input[1] = params.prefix
                    """
                }
            }
        }

        when {
            params {
                metadata  = "${baseDir}/${testDataDir}/metadata/pooled_screen_meta_ilmn_group_conditions_error_1.csv"
                fastq_dir = "${baseDir}/${testDataDir}/testdata"
                prefix    = "test"
                outdir    = outputDir
            }

            process {
                """
                input[0] = PARSE_METADATA_ILLUMINA.out.meta_yaml
                input[1] = params.fastq_dir
                input[2] = params.prefix
                """
            }
        }

        then {
            assert process.exitStatus != 0
            assert process.errorMessage.contains("Number of groups does not match the number of conditions")
        }
    }

    test("Groups vs Conditions Error: One group contains multiple conditions") {
        tag "validate_metadata_group_error"
        tag "validate_metadata_group-vs-conditions_2_illumina"

