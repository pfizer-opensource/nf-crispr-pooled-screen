    test("Control Normalization - Missing Controls File") {
        tag "qc_norm_control_missing_file"
        tag "qc_norm"
        tag "normalization"

        when {
            params {
                normalization_method       = 'control'
                prefix                     = 'test'
                outdir                     = "$outputDir"
            }
            process {
                """
                input[0] = tuple("3000",
                                 "test.count.max_3000X",
                                 "$baseDir/tests/test-datasets/guide_counts/test.count.max_3000X.txt",
                                 "$baseDir/tests/test-datasets/guide_counts/test.count.max_3000X.yml")
                input[1] = "${params.prefix}"
                input[2] = []  // Use empty list for missing control_guides path input
                input[3] = []  // Use empty list for unused annotation_dict path input
                """
            }
        }

        then {
            assert process.exitStatus != 0
            assert process.errorMessage.contains("No control guides found")
        }

    }

    test("No Normalization") {
        tag "qc_norm_none"
        tag "qc_norm"
        tag "normalization"

        when {
            params {
