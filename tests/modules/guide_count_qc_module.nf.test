                input[2] = []  // Use empty list for unused control_guides path input
                input[3] = []  // Use empty list for unused annotation_dict path input
                """
            }
        }

        then {
            assert process.success
            assert process.out.pdf == []
            assert snapshot(
                process.out.normalizedtables,
                process.out.longshapetables,
                process.out.correlationtables,
            ).match()
        }

    }

    test("Detect Inconsistent Representation Error") {
        tag "qc_representation_error"

        when {
            params {
                prefix                     = 'test'
                outdir                     = "$outputDir"
            }
            process {
                """
                input[0] = tuple("1000",
                                 "test.count.max_3000X",
                                 "$baseDir/tests/test-datasets/guide_counts/test.count.max_3000X.txt",
                                 "$baseDir/tests/test-datasets/guide_counts/test.count.max_3000X.yml")
                input[1] = "${params.prefix}"
                input[2] = []  // Use empty list for unused control_guides path input
                input[3] = []  // Use empty list for unused annotation_dict path input
                """
            }
        }

        then {
            assert process.exitStatus != 0
        }

    }

    test("With Annotation Dictionary - Single Group Definition") {
        tag "qc_annotation_single"
        tag "qc_annotation"

        when {
            params {
                prefix                     = 'test'
                outdir                     = "$outputDir"
            }
            process {
                """
                input[0] = tuple("3000",
                                 "test.count.max_3000X",
                                 "$baseDir/tests/test-datasets/guide_counts/test.count.max_3000X.txt",
                                 "$baseDir/tests/test-datasets/guide_counts/test.count.max_3000X.yml")
                input[1] = "${params.prefix}"
                input[2] = []  // Use empty list for unused control_guides path input
                input[3] = "$baseDir/tests/test-datasets/input_sample_table/annotate_dict.yml"
