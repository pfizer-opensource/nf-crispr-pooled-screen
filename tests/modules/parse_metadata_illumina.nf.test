nextflow_process {
    process "PARSE_METADATA_ILLUMINA"
    name "Test Process PARSE_METADATA_ILLUMINA"

    tag "metadata"
    tag "parse_metadata"
    tag "parse_metadata_illumina"

    script "modules/pfizer-rd/parse_metadata/illumina/main.nf"

    // Note: test data is not included in public release

    test("Illumina Sample Sheet Parsing") {
        when {
            params {
                metadata  = "${baseDir}/tests/test-datasets/metadata/pooled_screen_meta_ilmn.csv"
                outdir    = outputDir
            }

            process {
                """
                input[0] = params.metadata
                """
            }
        }

        then {
            assert process.success
            assert process.out.metadata_yaml.get(0) ==~ ".*/parsed-metadata.yaml"
            assert snapshot(process.out.metadata_yaml).match()
        }
    }
}
