nextflow_process {

    name "Test Process SAMPLE_META_MODULE"
    tag "sample_meta"
    script "modules/local/sample_meta_module.nf"
    process "SAMPLE_META_MODULE"

    // Note: test data is not included in public release

    test("Sample Metadata Generation") {
        tag "meta_main"

        when {
            params {
                fastq_dir = "$baseDir/tests/test-datasets/testdata"
                metadata  = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table.csv"
                prefix    = 'test'
                outdir    = "$outputDir"
            }
            process {
                """
                input[0] = "${params.fastq_dir}"
                input[1] = "${params.metadata}"
                input[2] = "${params.prefix}"
                """
            }
        }

        then {
            assert process.success
            assert process.out.sample_meta_yaml.get(0) ==~ ".*/${params.prefix}.metadata.yaml"
            assert snapshot(process.out.sample_meta_yaml).match()
        }

    }

    test("No Group Definition") {
        tag "no_group"

        when {
            params {
                fastq_dir = "$baseDir/tests/test-datasets/testdata"
                metadata  = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table_no_group.csv"
                prefix    = 'test'
                outdir    = "$outputDir"
            }
            process {
                """
                input[0] = "${params.fastq_dir}"
                input[1] = "${params.metadata}"
                input[2] = "${params.prefix}"
                """
            }
        }

        then {
            assert process.success
            assert process.out.sample_meta_yaml.get(0) ==~ ".*/${params.prefix}.metadata.yaml"
            assert snapshot(process.out.sample_meta_yaml).match()
        }

    }

    test("Detect Defined Groups vs Conditions Error 1 - one set of conditions in multiple groups") {
        tag "group_conditions_error_1"
        tag "group_error"

        when {
            params {
                fastq_dir = "$baseDir/tests/test-datasets/testdata"
                metadata  = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table_defined_group_conditions_error_1.csv"
                prefix    = 'test'
                outdir    = "$outputDir"
            }
            process {
                """
                input[0] = "${params.fastq_dir}"
                input[1] = "${params.metadata}"
                input[2] = "${params.prefix}"
                """
            }
        }

        then {
            assert process.exitStatus != 0
            assert process.errorMessage.contains("Exception: Number of groups does not match the number of conditions.")
        }

    }

    test("Detect Defined Groups vs Conditions Error 2 - one group contains multiple conditions") {
        tag "group_conditions_error_2"
        tag "group_error"

        when {
            params {
                fastq_dir = "$baseDir/tests/test-datasets/testdata"
                metadata  = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table_defined_group_conditions_error_2.csv"
                prefix    = 'test'
                outdir    = "$outputDir"
            }
            process {
                """
                input[0] = "${params.fastq_dir}"
                input[1] = "${params.metadata}"
                input[2] = "${params.prefix}"
                """
            }
        }

        then {
            assert process.exitStatus != 0
            assert process.errorMessage.contains("Exception: Number of groups does not match the number of conditions.")
        }

    }

    test("Detect Group Definition Spaces Error") {
        tag "group_defined_spaces_error"
        tag "group_error"

        when {
            params {
                fastq_dir = "$baseDir/tests/test-datasets/testdata"
                metadata  = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table_defined_group_spaces_error.csv"
                prefix    = 'test'
                outdir    = "$outputDir"
                
            }
            process {
                """
                input[0] = "${params.fastq_dir}"
                input[1] = "${params.metadata}"
                input[2] = "${params.prefix}"
                """
            }
        }

        then {
            assert process.exitStatus != 0
            assert process.errorMessage.contains("Exception: Group names contain spaces")
        }

    }

    test("Detect Group Interpolation Spaces Error") {
        tag "group_interpolated_spaces_error"
        tag "group_error"

        when {
            params {
                fastq_dir = "$baseDir/tests/test-datasets/testdata"
                metadata  = "$baseDir/tests/test-datasets/input_sample_table/pipeline_input_table_interpolated_group_spaces_error.csv"
                prefix    = 'test'
                outdir    = "$outputDir"
            }
            process {
                """
                input[0] = "${params.fastq_dir}"
                input[1] = "${params.metadata}"
                input[2] = "${params.prefix}"
                """
            }
        }

        then {
            assert process.exitStatus != 0
            assert process.errorMessage.contains("Exception: Group names contain spaces")
        }

    }

}
