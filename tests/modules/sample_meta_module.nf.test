nextflow_process {

    name "Test Process SAMPLE_META_MODULE"
    tag "sample_meta"
    script "modules/local/sample_meta_module.nf"
    process "SAMPLE_META_MODULE"

    def root_test_folder="test-datasets"  // Note: test data is not included in public release

    test("Sample Metadata Generation") {
        tag "meta_main"

        when {
            params {
                fastq_dir                  = "${root_test_folder}/testdata"
                sample_input_meta_table    = "${root_test_folder}/input_sample_table/pipeline_input_table.csv"
                prefix                     = 'test'
                outdir                     = "$outputDir"
            }
            process {
                """
                input[0] = "${params.fastq_dir}"
                input[1] = "${params.sample_input_meta_table}"
                input[2] = "${params.prefix}"
                """
            }
        }

        then {
            assert process.success
            assert process.out.sample_meta_yaml.get(0) ==~ ".*/${params.prefix}sample_meta.yml"
            assert snapshot(process.out.sample_meta_yaml).match()
        }

    }

    test("Detect Group Definition Error I - one set of conditions in multiple groups") {
        tag "group_error_I"
        tag "group_error"

        when {
            params {
                fastq_dir                  = "${root_test_folder}/testdata"
                sample_input_meta_table    = "${root_test_folder}/input_sample_table/pipeline_input_table_defined_group_error.csv"
                prefix                     = 'test'
                outdir                     = "$outputDir"
            }
            process {
                """
                input[0] = "${params.fastq_dir}"
                input[1] = "${params.sample_input_meta_table}"
                input[2] = "${params.prefix}"
                """
            }
        }

        then {
            assert process.exitStatus != 0
            assert process.errorMessage.contains("Exception: Number of groups does not match the number of conditions.")
        }

    }

    test("Detect Group Definition Error II - one group contains multiple conditions") {
        tag "group_error_II"
        tag "group_error"

        when {
            params {
                fastq_dir                  = "${root_test_folder}/testdata"
                sample_input_meta_table    = "${root_test_folder}/input_sample_table/pipeline_input_table_defined_group_error_2.csv"
                prefix                     = 'test'
                outdir                     = "$outputDir"
            }
            process {
                """
                input[0] = "${params.fastq_dir}"
                input[1] = "${params.sample_input_meta_table}"
                input[2] = "${params.prefix}"
                """
            }
        }

        then {
            assert process.exitStatus != 0
            assert process.errorMessage.contains("Exception: Number of groups does not match the number of conditions.")
        }

    }

}
